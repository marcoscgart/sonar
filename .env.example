# Copie para .env.local e preencha os valores reais (nunca commitar .env.local)

# Last.fm API — usado pelo motor de descobertas (similar artists)
LASTFM_API_KEY=

# Supabase — usado para autenticação e persistência opcional de perfil
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Workaround local (Windows) para erro de certificado TLS em dev.
# NÃO definir em produção/Vercel — lá não deve ser necessário.
# NODE_TLS_REJECT_UNAUTHORIZED=0
